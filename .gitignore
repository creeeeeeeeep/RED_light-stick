# 올라가면 안 되는 것 ------------------------------------------------------
#
# config.json 에는 서버가 만든 열쇠가 평문으로 들어 있다. 이게 공개되면 같은
# WiFi 에 있는 다른 사람이 남의 채팅에 이모티콘을 쏠 수 있다.
# rooms.json 은 방 개념을 쓰던 시절의 파일이다. 남아 있는 PC 가 있을 수 있어
# 계속 막아 둔다.
server/config.json
server/rooms.json
server/rooms.json.tmp

# 설정 예시는 올려도 된다 (실제 값이 없는 것)
!server/config.example.json

# 봉이 보낸 모션 로그. 개인정보는 아니지만 양이 많고 올릴 이유가 없다.
server/logs/

# 모니터 페이지가 찾아낸 감도 값. crown apply 가 읽어 소스를 고치고 나면
# 소스가 진짜 기준이 된다. 이 파일은 그 사이를 잇는 쪽지라 올리지 않는다.
server/tuning.json
server/tuning.json.tmp

# 빌드 산출물 ---------------------------------------------------------------
build/
build_dev/
sdkconfig
sdkconfig.old
sdkconfig.devbuild
sdkconfig.devbuild.old

firmware/build/
firmware/build_dev/

# OTA 로 내보내는 펌웨어. crown release 가 만들어내는 산출물이라 소스가 아니다.
# 각자 서버가 알아서 들고 있으면 된다.
server/firmware/*.bin
server/firmware/archive/

# 웹스토어 제출 패키지. extension/ 에서 다시 만들 수 있는 산출물이다.
# 리스팅 문구·아이콘·프로모 이미지는 소스이므로 올린다.
extension/확장 프로그램 출시 준비/크라운응원봉-*.zip

# 제출용 zip 을 풀어본 폴더. extension/ 과 같은 파일이라 두 벌이 된다.
# (git add -A 로 딸려 들어간 적이 있다)
extension/확장 프로그램 출시 준비/크라운응원봉-*/

# 3D 모델 -------------------------------------------------------------------
#
# 모델 자체는 올린다. 여기 말고는 백업이 없어서, 디스크가 죽으면 크라운 설계가
# 통째로 날아간다.
#
# 다만 폴더를 그대로 압축한 zip 은 제외한다 — 언제든 다시 만들 수 있고,
# 같은 내용을 두 번 저장하게 된다. zip 에만 들어 있던 파일은 폴더로 꺼내 둔다.
#
# git 은 바이너리를 통째로 저장하므로, 모델을 자주 고치게 되면 그때는
# Releases 나 별도 저장소로 옮기는 게 맞다.
modeling/RED_final/RED_최종_STL.zip
modeling/old/CROWN_v17.zip
modeling/old/CROWN_v18.zip
modeling/old/CROWN_v20.zip

# 잡동사니 -----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
Thumbs.db
desktop.ini
*.tmp

# 카페에 올리는 배포 묶음. 배포묶음_만들기.py 로 언제든 다시 만든다.
RED응원봉_v*.zip

# 한글 이름으로 복사해 둔 사본들 ------------------------------------------
#
# 작업 중에 server/ 와 modeling/ 을 한글 이름으로 복사해 둔 것이 있었다.
# 위의 무시 규칙은 영문 경로로 적혀 있어서 그 사본들이 그물을 빠져나갔고,
# git add -A 에 config.json(열쇠)까지 딸려 들어갔다.
#
# 한 벌만 저장소에 두는 것이 맞다. 사본은 통째로 막는다.
서버/
모델링 파일/
응원봉.zip

# 열쇠·로그는 어디에 있든 막는다 (폴더 이름이 또 바뀌어도 새지 않게)
**/config.json
!**/config.example.json
**/logs/

# launchpad/ 의 merged.bin 은 일부러 올린다 — 팬이 GitHub Pages 로 받아 굽는다.
