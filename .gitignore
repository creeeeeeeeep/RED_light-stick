# 올라가면 안 되는 것 ------------------------------------------------------
#
# rooms.json 에는 팬마다의 토큰이 평문으로 들어 있다. 이게 공개되면 그 방에
# 아무나 이모티콘을 쏠 수 있다. config.json 의 admin_token 은 아무 방에나
# 들어갈 수 있는 만능 키다. 둘 다 절대 커밋하지 않는다.
server/rooms.json
server/rooms.json.tmp
server/config.json

# 봉이 보낸 모션 로그. 개인정보는 아니지만 양이 많고 올릴 이유가 없다.
server/logs/

# 이전 버전 펌웨어 보관함. 배포용 하나만 올리면 된다.
server/firmware/archive/

# 설정 예시는 올려도 된다 (실제 값이 없는 것)
!server/config.example.json

# 빌드 산출물 ---------------------------------------------------------------
build/
build_dev/
sdkconfig
sdkconfig.old
sdkconfig.devbuild
sdkconfig.devbuild.old

firmware/build/
firmware/build_dev/

# 잡동사니 -----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
Thumbs.db
desktop.ini
*.tmp

# 3D 모델 -------------------------------------------------------------------
#
# 모델은 올린다. 여기 말고는 백업이 없어서, 디스크가 죽으면 크라운 설계가
# 통째로 날아간다.
#
# 다만 old/ 의 zip 세 개는 같은 폴더의 사본이라 제외한다 (파일 수·크기까지
# 일치하는 것을 확인했다). 7.7MB 를 그냥 아낀다.
#
# git 은 바이너리를 통째로 저장하므로, 모델을 자주 고치게 되면 그때는
# Releases 나 별도 저장소로 옮기는 게 맞다.
modeling/old/CROWN_v17.zip
modeling/old/CROWN_v18.zip
modeling/old/CROWN_v20.zip

# OTA 로 내보내는 펌웨어. crown release 가 만들어내는 산출물이라 소스가 아니다.
# 이건 각자 서버가 들고 있으면 된다.
server/firmware/*.bin

# server/launchpad/ 는 일부러 남긴다 — GitHub Pages 로 팬에게 나눠줄 때
# 그 폴더가 그대로 배포 대상이 된다.

# 웹스토어 제출 패키지. extension/ 에서 다시 만들 수 있는 산출물이다.
# 리스팅 문구·아이콘·프로모 이미지는 소스이므로 올린다.
extension/확장 프로그램 출시 준비/크라운응원봉-*.zip
